@model List<AccessLog>
@{ ViewData["Title"] = "Kontrol paneli"; }
<header class="page-heading"><div><p class="eyebrow">ERİŞİM YÖNETİMİ</p><h1>Laboratuvar kontrol paneli</h1><p>Kart okumalarını deneyin, sonuçları ve son işlemleri takip edin.</p></div><a class="button secondary" href="/Face">Kamera ekranını aç <span aria-hidden="true">↗</span></a></header>
<div class="notice"><span class="notice-icon" aria-hidden="true">i</span><div><strong>Test alanındasınız</strong><p>Sanal kart ve kamera testleri fiziksel giriş izni vermez. Yeşil sonuç yalnızca test başarısını gösterir.</p></div></div>
<div class="stats"><div class="stat"><span>Görüntülenen okumalar</span><strong>@Model.Count.ToString("00")</strong><small>En son 20 kayıt içinden</small></div><div class="stat"><span>Test kayıtları</span><strong>@Model.Count(x => x.IsSimulation).ToString("00")</strong><small>Görüntülenen kayıtlar içinde</small></div><div class="stat"><span>Donanım kayıtları</span><strong>@Model.Count(x => !x.IsSimulation).ToString("00")</strong><small>Görüntülenen kayıtlar içinde</small></div></div>
<div class="grid two"><section class="card"><div class="card-heading"><div><p class="eyebrow">01 / KART TESTİ</p><h2>Sanal kart okuyucu</h2></div><span class="pill amber-pill">Simülasyon</span></div>
@if (ViewBag.SimulationEnabled == true) {
<p>Kartı seçin veya UID girin. Bu bölüm yüz eşleşmesini taklit eder.</p>
<div class="quick-cards" aria-label="Örnek kartlar"><button type="button" class="chip" data-uid="A1B2C3D4">Yetkili kart</button><button type="button" class="chip" data-uid="11223344">Yetkisiz kart</button><button type="button" class="chip" data-uid="DEADBEEF">Bilinmeyen kart</button></div>
<form id="reader" asp-controller="Kiosk" asp-action="Simulate" method="post"><label for="uid">Kart UID</label><input id="uid" name="uid" value="A1B2C3D4" maxlength="60" required spellcheck="false" class="mono"/>
<label class="check-row" for="faceMatch"><input id="faceMatch" name="faceMatch" type="checkbox" value="true" checked/><span>Yüz eşleşmesini taklit et<small>İşareti kaldırırsanız yüz uyuşmazlığı denenir.</small></span></label><button type="submit" class="button primary">Kartı okut <span aria-hidden="true">→</span></button></form>
} else { <div class="empty"><h3>Simülasyon kapalı</h3><p>Sanal okuyucuyu kullanmak için geliştirme ortamında simülasyonu etkinleştirin.</p></div> }
</section><section class="card result-card"><p class="eyebrow">ANLIK SONUÇ</p><h2>Okuma durumu</h2><div class="reader-symbol" aria-hidden="true">◎</div><output id="result" class="result-box" aria-live="polite">Kart bekleniyor. Soldaki okuyucudan bir deneme başlatın.</output><p class="result-footnote">Gerçek yüz eşleşmesini denemek için kamera ekranını kullanın.</p><a class="text-link" href="/Face">Kamera ile doğrulamaya geç →</a></section></div>
<section class="card"><div class="card-heading"><div><p class="eyebrow">İŞLEM GEÇMİŞİ</p><h2>Son kart okumaları</h2></div><button type="button" class="button secondary" onclick="location.reload()">Kayıtları yenile</button></div><p>En son 20 işlem. Test kayıtları gerçek giriş anlamına gelmez.</p>
@if (Model.Count == 0) { <div class="empty"><div class="empty-icon" aria-hidden="true">≡</div><h3>Henüz kart okunmadı</h3><p>İlk denemenizden sonra kayıtlar burada görünecek.</p></div> }
else { <div class="table-scroll"><table><thead><tr><th>Zaman</th><th>Kullanıcı</th><th>Kart UID</th><th>Ortam</th><th>Sonuç</th></tr></thead><tbody>
@foreach(var log in Model) { <tr><td><time datetime="@log.Giris_Zamani.ToString("O")">@log.Giris_Zamani.ToString("u")</time></td><td><strong>@(log.User?.AdSoyad ?? "Bilinmeyen kart")</strong></td><td><code>@log.Kart_UID</code></td><td><span class="pill @(log.IsSimulation ? "amber-pill" : "muted")">@(log.IsSimulation ? "Test" : "Donanım")</span></td><td class="status-cell">@log.Durum</td></tr> }
</tbody></table></div> }</section>
@section Scripts { <script src="~/kiosk.js" asp-append-version="true"></script> }
