@model List<User>
@{ ViewData["Title"] = "Kamera ve yüz kaydı"; }
<header class="page-heading"><div><p class="eyebrow">KİMLİK DOĞRULAMA</p><h1>Kamera ve yüz kaydı</h1><p>Kamerayı kontrol edin, referans kaydedin ve kart sahibini doğrulayın.</p></div><span class="pill @(ViewBag.FaceEnabled == true ? "green-pill" : "muted")"><span class="dot"></span> Yüz servisi @(ViewBag.FaceEnabled == true ? "etkin" : "kapalı")</span></header>
<div class="notice"><span class="notice-icon" aria-hidden="true">i</span><div><strong>Fiziksel erişim kapalı · kamera testi</strong><p>Test sonuçları kapı açmaz. Canlılık kontrolü bulunmadığından fotoğrafla aldatmaya karşı doğrulanmış değildir.</p></div></div>
<div class="steps" aria-label="İşlem sırası"><span><b>1</b> Kamerayı kontrol et</span><span><b>2</b> Referans kaydet</span><span><b>3</b> Yüzü doğrula</span></div>
<div class="grid camera-grid"><section class="card camera-card"><div class="card-heading"><div><p class="eyebrow">01 / GÖRÜNTÜ</p><h2>Kamera önizlemesi</h2></div><span class="pill muted">Anlık görüntü</span></div>
<div class="camera-frame"><div id="camera-placeholder" class="camera-placeholder"><span aria-hidden="true">◎</span><h3>Kamera görüntüsü bekleniyor</h3><p>Başlamak için aşağıdaki düğmeye basın.</p></div><img id="camera-image" alt="Kameradan alınan son anlık görüntü" hidden/></div><p id="camera-caption" class="helper">Kamerada yalnız bir kişi bulunmalı. Kamerayı kullanan diğer uygulamaları kapatın.</p>
<form class="face-form" asp-action="Snapshot" method="post" data-operation="snapshot"><button type="submit" class="button primary">Anlık görüntü al</button></form><div class="camera-meta"><span>Fotoğraf diske kaydedilmez</span><span>Her işlem yeni görüntü alır</span></div></section>
<section class="card"><p class="eyebrow">03 / DOĞRULAMA</p><h2>Kart + gerçek yüz testi</h2><p>Referansı kayıtlı kartın sahibi kamerada yalnızken doğrulamayı başlatın.</p>
<form class="face-form" asp-action="Verify" method="post" data-operation="verify"><label for="verify-uid">Kart UID</label><input id="verify-uid" name="uid" value="A1B2C3D4" required maxlength="60" class="mono" spellcheck="false"/><button type="submit" class="button primary">Kartı okut ve yüzü doğrula →</button></form>
<div class="result-area"><span class="eyebrow">SON İŞLEM</span><output id="face-result" class="result-box" aria-live="polite" tabindex="-1">İşlem bekleniyor. İlk kez kullanıyorsanız önce bir referans yüz kaydedin.</output></div><p class="helper">Karşılaştırma mesafe eşiği: @ViewBag.Tolerance. Bu değer bir başarı yüzdesi değildir.</p></section></div>
<section class="card"><div class="card-heading"><div><p class="eyebrow">02 / REFERANS</p><h2>Referans yüz kaydı</h2></div><span class="pill muted">Anahtar gerekli</span></div><p>Yüzü kaydedilecek kart sahibi kamerada yalnız olmalı. İlk kayıt için değiştirme kutusunu boş bırakın.</p>
<form class="face-form enrollment-form" asp-action="Enroll" method="post" data-operation="enroll"><div class="form-columns"><div class="field"><label for="enroll-uid">Kart UID</label><input id="enroll-uid" name="uid" value="A1B2C3D4" required maxlength="60" class="mono" spellcheck="false"/></div><div class="field"><label for="enroll-key">Yüz kayıt anahtarı</label><input id="enroll-key" name="adminKey" type="password" autocomplete="off" required aria-describedby="key-help"/><small id="key-help" class="helper">Sunucuyu başlatırken belirlediğiniz anahtar. Kart UID’si değildir.</small></div></div>
<label class="check-row"><input type="checkbox" name="consent" value="true" required/><span>Yüzümün bu proje için referans vektörü olarak kaydedilmesini onaylıyorum.</span></label>
<label class="check-row"><input type="checkbox" name="replace" value="true"/><span>Mevcut yüz kaydını değiştir<small>Yalnızca kayıtlı bir referansı güncellerken seçin.</small></span></label><button type="submit" class="button primary">Referans yüz kaydet</button></form></section>
<section class="card"><div class="card-heading"><div><p class="eyebrow">KAYITLI KULLANICILAR</p><h2>Referans yüzler <span class="count" id="face-count">@Model.Count(x => x.Face_Encoding is { Length: > 0 }) / @Model.Count</span></h2></div><button class="button secondary" type="button" onclick="location.reload()">Listeyi yenile</button></div>
<div class="table-scroll"><table><thead><tr><th>Kullanıcı</th><th>Kart UID</th><th>Referans durumu</th><th></th></tr></thead><tbody>
@foreach(var user in Model) { <tr data-user-uid="@user.Kart_UID"><td><strong>@user.AdSoyad</strong><small class="student-number">@user.OgrenciNo</small></td><td><code>@user.Kart_UID</code></td><td><span class="pill face-state @(user.Face_Encoding is { Length: > 0 } ? "green-pill" : "muted")">@(user.Face_Encoding is { Length: > 0 } ? "Kayıtlı" : "Kayıt yok")</span></td><td><button type="button" class="chip select-card" data-uid="@user.Kart_UID">Kartı seç</button></td></tr> }
</tbody></table></div></section>
<section class="card danger-zone"><details><summary>Referans kaydını sil <span>Yalnızca yüz vektörü kaldırılır; kullanıcı ve kart korunur.</span></summary><form class="face-form" asp-action="Delete" method="post" data-operation="delete"><div class="form-columns"><div class="field"><label for="delete-uid">Kart UID</label><input id="delete-uid" name="uid" required maxlength="60" class="mono"/></div><div class="field"><label for="delete-key">Yüz kayıt anahtarı</label><input id="delete-key" name="adminKey" type="password" required autocomplete="off"/></div></div><button type="submit" class="button danger">Yüz kaydını sil</button></form></details></section>
@section Scripts { <script src="~/face.js" asp-append-version="true"></script> }
